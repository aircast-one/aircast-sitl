+void ModeLoiter::point_nose(float target_yaw_rate)
+{
+    const Vector3f thrust_vector = loiter_nav->get_thrust_vector();
+    if (!is_zero(target_yaw_rate)) {
+        heading_held = false;
+    } else if (!heading_held && fabsf(attitude_control->get_attitude_target_ang_vel().z) < radians(2.0f)) {
+        held_heading_cd = attitude_control->get_att_target_euler_cd().z;
+        heading_held = true;
+    }
+    if (heading_held) {
+        attitude_control->input_thrust_vector_heading(thrust_vector, held_heading_cd, 0.0f);
+    } else {
+        attitude_control->input_thrust_vector_rate_heading(thrust_vector, target_yaw_rate, false);
+    }
+}
