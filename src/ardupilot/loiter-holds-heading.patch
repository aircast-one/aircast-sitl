+void ModeLoiter::point_nose(float target_yaw_rate_rads)
+{
+    const Vector3f thrust_vector = loiter_nav->get_thrust_vector();
+    if (!is_zero(target_yaw_rate_rads)) {
+        heading_held = false;
+    } else if (!heading_held && fabsf(attitude_control->get_attitude_target_ang_vel().z) < radians(2.0f)) {
+        held_heading_rad = attitude_control->get_att_target_euler_rad().z;
+        heading_held = true;
+    }
+    loiter_nav->set_heading_held(heading_held);
+    if (heading_held) {
+        attitude_control->input_thrust_vector_heading_rad(thrust_vector, held_heading_rad, 0.0f);
+    } else {
+        attitude_control->input_thrust_vector_rate_heading_rads(thrust_vector, target_yaw_rate_rads, false);
+    }
+}
+
 // loiter_run - runs the loiter controller
 // should be called at 100hz or more
